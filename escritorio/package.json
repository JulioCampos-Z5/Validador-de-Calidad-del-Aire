{
  "name": "validador-escritorio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App de escritorio del Validador de Calidad del Aire",
  "main": "main.mjs",
  "scripts": {
    "test": "node --test \"pruebas/*.test.mjs\"",
    "dev": "pnpm --filter validador-calidad-aire-frontend build && electron .",
    "backend": "python -m PyInstaller --distpath ../backend/dist --workpath ../backend/build --noconfirm ../backend/validador-backend.spec",
    "exe": "pnpm --filter validador-calidad-aire-frontend build && pnpm backend && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "gob.jalisco.simaj.validador",
    "productName": "Validador Calidad del Aire",
    "directories": {
      "output": "../salida"
    },
    "files": [
      "main.mjs",
      "seguridad.mjs",
      "bitacora.mjs",
      "package.json",
      "icono.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/validador-backend",
        "to": "backend-exe"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "icon": "icono.png",
      "signtoolOptions": {
        "publisherName": "Laboratorio de Calidad del Aire - SIMAJ",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Validador-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Validador-instalador.exe"
    }
  }
}
