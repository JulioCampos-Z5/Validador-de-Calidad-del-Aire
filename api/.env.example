# Copia este archivo a api/.env y cambia los valores. api/.env no se sube.

API_DIRECCION=:8081
# Al menos 32 caracteres aleatorios. Si cambia, todas las sesiones se cierran.
API_LLAVE_JWT=cambia-esto-por-32-o-mas-caracteres-aleatorios
API_DURACION_SESION=12h

# MySQL de desarrollo (api/dev/docker-compose.yml)
MYSQL_ROOT_PASSWORD=cambia-esto
MYSQL_PASSWORD=cambia-esto

# Una cadena por base. Sin la de un modulo, ese modulo queda "en proceso".
MYSQL_DSN_SEMADET=validador:cambia-esto@tcp(127.0.0.1:3307)/semadet
MYSQL_DSN_PUERTOS=validador:cambia-esto@tcp(127.0.0.1:3307)/monitor_puertos
# Inventario sigue en proceso en produccion: dejalo vacio hasta crear su base.
MYSQL_DSN_INVENTARIO=

# Backend de analisis en Python (Flask). Vacio = Validacion y Graficas en proceso.
VALIDADOR_BACKEND_URL=http://127.0.0.1:8010

# Puertos: sin latido por mas de esto, la estacion queda "sin comunicacion".
PUERTOS_TOLERANCIA_LATIDO=3m
PUERTOS_INTERVALO_REVISION=1m

# Niveles por tiempo sin datos (doc/ARQUITECTURA-v2.md, seccion 6)
UMBRAL_AVISO=1h
UMBRAL_CRITICO=4h
UMBRAL_INCUMPLE=6h
