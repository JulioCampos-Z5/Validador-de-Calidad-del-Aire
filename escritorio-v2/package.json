{
  "name": "validador-escritorio-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "App de escritorio del Validador de Calidad del Aire (v2): API de Go con SQLite, motor de Python y front v2",
  "main": "main.mjs",
  "scripts": {
    "test": "node --test \"pruebas/*.test.mjs\"",
    "web": "pnpm --dir ../web build",
    "api": "go build -C ../api -trimpath -ldflags \"-s -w\" -o ../escritorio-v2/build/validador-api.exe ./cmd/api",
    "backend": "python -m PyInstaller --distpath ../backend/dist --workpath ../backend/build --noconfirm ../backend/validador-backend.spec",
    "dev": "pnpm web && pnpm api && pnpm llaves && electron .",
    "exe": "pnpm web && pnpm api && pnpm llaves && pnpm backend && electron-builder --win --publish never",
    "llaves": "node preparar-llaves.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "gob.jalisco.simaj.validador.v2",
    "productName": "Validador Calidad del Aire v2",
    "directories": {
      "output": "../salida-v2"
    },
    "files": [
      "main.mjs",
      "config.mjs",
      "seguridad.mjs",
      "bitacora.mjs",
      "package.json",
      "icono.png"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "api",
        "filter": [
          "validador-api.exe"
        ]
      },
      {
        "from": "../backend/dist/validador-backend",
        "to": "backend-exe"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/llaves.env",
        "to": "llaves.env"
      }
    ],
    "win": {
      "icon": "icono.png",
      "signtoolOptions": {
        "publisherName": "Laboratorio de Calidad del Aire - SIMAJ",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Validador-v2-instalador.exe"
    }
  }
}
